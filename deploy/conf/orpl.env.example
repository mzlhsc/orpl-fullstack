# /opt/orpl/conf/orpl.env —— 由 install.sh 自动生成，按需修改后 systemctl restart orpl
SERVER_PORT=8080

DB_USER=orpl
DB_PASSWORD=Orpl@2026

REDIS_PASSWORD=Orpl@2026

# 微信小程序真实登录（不填则走开发模式：code 直接当 openid）
WECHAT_APPID=
WECHAT_SECRET=

# 阿里云 OSS（配置齐全则上传走 OSS；全部留空则自动存本地 /opt/orpl/web/uploads）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 接口文档开关，演示环境建议 true
KNIFE4J_ENABLE=true


# 文件存储：auto（默认，有 OSS 用 OSS，没有就存本地）/ oss / local
STORAGE_TYPE=auto
STORAGE_LOCAL_DIR=/opt/orpl/web/uploads
STORAGE_PUBLIC_PREFIX=/uploads
