<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_pad">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Orpl.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_pad">

                    <TextView
                        style="@style/Text.Orpl.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="基本信息"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_image"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_tag_neutral"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/et_image"
                                style="@style/Widget.Orpl.Input"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:hint="图片地址，或点下方按钮上传"
                                android:inputType="textUri"
                                android:maxLines="1"
                                android:textSize="12.5sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_pick_image"
                                    style="@style/Widget.Orpl.Button.Small.Ghost"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="上传图片" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_clear_image"
                                    style="@style/Widget.Orpl.Button.Small.Ghost"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="清空" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Orpl.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="套餐名称" />

                    <EditText
                        android:id="@+id/et_name"
                        style="@style/Widget.Orpl.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="6dp"
                        android:hint="例如：工作日双人餐"
                        android:inputType="text"
                        android:maxLines="1" />

                    <TextView
                        style="@style/Text.Orpl.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="所属分类（套餐分类）" />

                    <TextView
                        android:id="@+id/tv_category"
                        style="@style/Widget.Orpl.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="请选择分类"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Text.Orpl.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="价格（元）" />

                    <EditText
                        android:id="@+id/et_price"
                        style="@style/Widget.Orpl.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="6dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />

                    <TextView
                        style="@style/Text.Orpl.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="套餐描述" />

                    <EditText
                        android:id="@+id/et_desc"
                        style="@style/Widget.Orpl.Input"
                        android:layout_width="match_parent"
                        android:layout_height="78dp"
                        android:layout_marginTop="6dp"
                        android:gravity="top"
                        android:hint="一句话介绍，可为空"
                        android:inputType="textMultiLine"
                        android:paddingTop="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Orpl.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="起售状态"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Orpl.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Orpl.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="套餐菜品"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/btn_add_dish"
                            style="@style/Text.Orpl.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="＋ 添加菜品"
                            android:textColor="@color/brand_strong"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dish_hint"
                        style="@style/Text.Orpl.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="至少添加一个菜品，份数可调整" />

                    <LinearLayout
                        android:id="@+id/dish_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Orpl.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="保存" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
