<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Orpl.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的" />

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="账号、门店状态与常用管理入口" />

        <!-- 账号卡 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Orpl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="管"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/Text.Orpl.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:text="管理员" />

                    <TextView
                        android:id="@+id/tv_username"
                        style="@style/Text.Orpl.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="—" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_role_tag"
                    style="@style/Widget.Orpl.Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="管理员" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 门店状态 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Orpl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Orpl.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="门店营业状态"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_shop_desc"
                        style="@style/Text.Orpl.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="状态会同步到用户端" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 自动接单 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Orpl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Orpl.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="外卖自动接单"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Orpl.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="开启后新外卖订单直接进入已接单" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_takeout_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/line_soft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Orpl.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="堂食自动接单"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Orpl.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="同桌加菜提交后自动接单，直接进入备餐" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_dining_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Orpl.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="开关只影响设置之后的新订单，历史订单状态不会追溯变更。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 管理入口 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Orpl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:id="@+id/container_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Orpl.Button.DangerGhost"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:text="@string/logout" />

        <TextView
            style="@style/Text.Orpl.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="order-platform · 管理端 v1.0.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
