<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="姓名" />

        <EditText
            android:id="@+id/et_name"
            style="@style/Widget.Orpl.Input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:hint="例如：张三"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="登录账号" />

        <EditText
            android:id="@+id/et_username"
            style="@style/Widget.Orpl.Input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:hint="英文或数字，不可重复"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="手机号" />

        <EditText
            android:id="@+id/et_phone"
            style="@style/Widget.Orpl.Input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:hint="11 位手机号"
            android:inputType="phone"
            android:maxLength="11"
            android:maxLines="1" />

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="性别" />

        <TextView
            android:id="@+id/tv_sex"
            style="@style/Widget.Orpl.Input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="请选择"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.Orpl.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="身份证号" />

        <EditText
            android:id="@+id/et_id_number"
            style="@style/Widget.Orpl.Input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:hint="18 位身份证号"
            android:inputType="text"
            android:maxLength="18"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_hint"
            style="@style/Text.Orpl.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="新增员工默认密码 123456，创建后可在列表里启用/禁用" />
    </LinearLayout>
</ScrollView>
