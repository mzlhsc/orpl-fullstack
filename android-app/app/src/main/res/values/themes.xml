<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.OrplAdmin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_strong</item>
        <item name="colorSecondary">@color/brand_strong</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/bg</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/card</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Orpl.Dialog</item>
    </style>

    <style name="ThemeOverlay.Orpl.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Orpl.Dialog</item>
    </style>

    <style name="ShapeAppearance.Orpl.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ================= 卡片 ================= -->
    <style name="Widget.Orpl.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="android:layout_marginBottom">@dimen/gap</item>
    </style>

    <!-- ================= 按钮 ================= -->
    <style name="Widget.Orpl.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <style name="Widget.Orpl.Button.Primary" parent="Widget.Orpl.Button" />

    <style name="Widget.Orpl.Button.Ghost" parent="Widget.Orpl.Button">
        <item name="backgroundTint">@color/card</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="rippleColor">@color/line_soft</item>
    </style>

    <style name="Widget.Orpl.Button.Soft" parent="Widget.Orpl.Button">
        <item name="backgroundTint">@color/brand_soft</item>
        <item name="android:textColor">@color/brand_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/brand_line</item>
        <item name="rippleColor">@color/brand_line</item>
    </style>

    <style name="Widget.Orpl.Button.DangerGhost" parent="Widget.Orpl.Button">
        <item name="backgroundTint">@color/card</item>
        <item name="android:textColor">@color/danger</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/danger_line</item>
        <item name="rippleColor">@color/danger_soft</item>
    </style>

    <style name="Widget.Orpl.Button.Small" parent="Widget.Orpl.Button">
        <item name="android:minHeight">34dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.Orpl.Button.Small.Ghost" parent="Widget.Orpl.Button.Ghost">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="cornerRadius">7dp</item>
    </style>

    <style name="Widget.Orpl.Button.Small.Primary" parent="Widget.Orpl.Button.Small">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">7dp</item>
    </style>

    <style name="Widget.Orpl.Button.Small.DangerGhost" parent="Widget.Orpl.Button.DangerGhost">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="cornerRadius">7dp</item>
    </style>

    <style name="Widget.Orpl.Button.Small.Soft" parent="Widget.Orpl.Button.Soft">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="cornerRadius">7dp</item>
    </style>

    <!-- ================= 文字 ================= -->
    <style name="Text.Orpl.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Orpl.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Orpl.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Orpl.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Orpl.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/muted_2</item>
    </style>

    <style name="Text.Orpl.Num" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- ================= 输入框 ================= -->
    <style name="Widget.Orpl.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted_2</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- ================= 标签 ================= -->
    <style name="Widget.Orpl.Tag" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:background">@drawable/bg_tag_neutral</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
