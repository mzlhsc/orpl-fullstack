.hero {
  padding-bottom: 38rpx;
}

.search-box {
  margin-top: 28rpx;
}

.search-clear {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.1);
  font-size: 30rpx;
  line-height: 1;
}

.session-strip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
}

.session-strip-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: #e8552d;
  font-size: 22rpx;
  font-weight: 700;
}

.session-strip-title {
  font-size: 25rpx;
  font-weight: 600;
}

.session-strip-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

.session-strip-side {
  text-align: right;
  flex-shrink: 0;
}

.session-strip-amount {
  font-size: 26rpx;
  font-weight: 700;
  color: #f9c7b5;
}

.session-strip-enter {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.58);
}

.dining-invite {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

.dining-invite-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #e8552d;
}

.dining-invite-arrow {
  margin-left: auto;
  font-size: 32rpx;
  line-height: 1;
}

.menu-body {
  padding-top: 20rpx;
}

.closed-banner {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #f6d9bd;
  border-radius: 16rpx;
  background: #fff7ed;
  font-size: 22rpx;
  color: #9a5b19;
}

.menu-switch {
  width: 100%;
}

.category-scroll {
  margin-top: 22rpx;
}

.menu-section-head {
  margin-top: 26rpx;
}

.dish-card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
}

.dish-thumb {
  position: relative;
  flex-shrink: 0;
}

.dish-main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 170rpx;
  padding: 4rpx 0 2rpx;
}

.dish-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.dish-name {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1f2937;
}

.dish-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8a8f98;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-flavor {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f8f4ee;
  font-size: 19rpx;
  color: #9a6b4f;
}

.dish-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dish-price {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  color: #e8552d;
}

.add-btn {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e8552d;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(232, 85, 45, 0.24);
}

.add-btn-disabled {
  background: #eceef0;
  color: #9ca3af;
  box-shadow: none;
  font-size: 20rpx;
  font-weight: 600;
}

.setmeal-card:active {
  transform: scale(0.985);
}

.setmeal-flag {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.82);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
}

.setmeal-chev {
  font-size: 36rpx;
  line-height: 1;
  color: #c3c7cd;
}

.setmeal-action {
  font-size: 20rpx;
  font-weight: 600;
  color: #b45309;
}

.menu-footer-note {
  padding: 24rpx 0 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b2b5ba;
}

.retry-btn {
  margin-top: 24rpx;
}

.cart-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.menu-page .fixed-bar-tab {
  bottom: 0;
}

.cart-bubble {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: #1f2937;
}

.cart-bubble-icon {
  width: 28rpx;
  height: 24rpx;
  border: 3rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  position: relative;
}

.cart-bubble-icon::before {
  content: "";
  position: absolute;
  width: 18rpx;
  height: 12rpx;
  left: 2rpx;
  top: -14rpx;
  border: 3rpx solid #ffffff;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.cart-badge {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #e8552d;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.cart-summary {
  min-width: 0;
}

.cart-total {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  color: #1f2937;
}

.cart-hint {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #9ca3af;
}

.cart-button {
  width: 230rpx !important;
  height: 76rpx;
  flex-shrink: 0;
  font-size: 25rpx;
}

.flavor-sheet,
.setmeal-sheet {
  padding-top: 20rpx;
}

.flavor-product {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fbf8f3;
}

.flavor-thumb {
  flex-shrink: 0;
}

.flavor-product-name {
  font-size: 28rpx;
  font-weight: 700;
}

.flavor-product-price {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #e8552d;
}

.flavor-scroll {
  max-height: 44vh;
  margin-top: 22rpx;
}

.flavor-group {
  margin-bottom: 26rpx;
}

.flavor-group-title {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5563;
}

.flavor-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.flavor-confirm {
  margin-top: 10rpx;
}

.setmeal-cover {
  position: relative;
  height: 280rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f1ede6;
}

.setmeal-cover-img {
  width: 100%;
  height: 100%;
}

.setmeal-cover-price {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.86);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.setmeal-items-title {
  margin-top: 26rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.setmeal-items {
  max-height: 32vh;
}

.setmeal-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3efe9;
}

.setmeal-item:last-child {
  border-bottom: none;
}

.setmeal-item-thumb {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
}

.setmeal-item-name {
  font-size: 25rpx;
  font-weight: 600;
}

.setmeal-copies {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #e8552d;
}

.setmeal-item-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.setmeal-add-btn {
  margin-top: 20rpx;
}

/* ========== 左分类 / 右菜品点单布局 ========== */
.menu-page {
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.menu-hero {
  flex-shrink: 0;
  padding: 24rpx 28rpx 28rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.menu-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.menu-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.menu-sub {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.58);
}

.menu-table-chip {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fbd8ca;
  font-size: 21rpx;
  font-weight: 600;
}

.menu-hero .search-box {
  margin-top: 18rpx;
}

.menu-hero .session-strip {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 17rpx;
}

.menu-hero .dining-invite {
  margin-top: 16rpx;
}

.menu-toolbar {
  flex-shrink: 0;
  padding-top: 16rpx;
}

.menu-toolbar .menu-switch {
  width: 100%;
}

.menu-state {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx 220rpx;
}

.menu-workbench {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
  background: #f7f4ef;
}

.category-rail {
  width: 178rpx;
  height: 100%;
  flex-shrink: 0;
  border-right: 1rpx solid #ebe3d9;
  background: #f1ece4;
}

.rail-caption {
  padding: 22rpx 16rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #a08f7d;
}

.rail-item {
  position: relative;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 14rpx 18rpx 16rpx;
  color: #6f6255;
  font-size: 24rpx;
  line-height: 1.35;
}

.rail-item-active {
  background: #ffffff;
  color: #1f2937;
  font-weight: 700;
}

.rail-item-active .rail-label {
  transform: translateX(4rpx);
}

.rail-bar {
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 34rpx;
  transform: translateY(-50%);
  border-radius: 0 6rpx 6rpx 0;
  background: transparent;
}

.rail-item-active .rail-bar {
  background: #e8552d;
}

.rail-label {
  transition: transform 0.15s ease;
}

.dish-panel {
  flex: 1;
  height: 100%;
  min-width: 0;
}

.dish-panel-inner {
  padding: 22rpx 22rpx calc(230rpx + env(safe-area-inset-bottom)) 18rpx;
}

.dish-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.dish-panel-eyebrow {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #b45309;
}

.dish-panel-title {
  margin-top: 2rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #1f2937;
}

.dish-panel-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a8f98;
}

.dish-empty {
  padding-top: 90rpx;
}

.dish-card {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
}

.dish-thumb {
  width: 190rpx;
  height: 190rpx;
  border-radius: 19rpx;
}

.dish-sold-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: rgba(31, 41, 55, 0.62);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dish-main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 190rpx;
  padding: 2rpx 0;
}

.dish-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.dish-name {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1f2937;
}

.dish-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.42;
  color: #8a8f98;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-flavor {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #f8f4ee;
  font-size: 18rpx;
  color: #9a6b4f;
}

.dish-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
}

.dish-price {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  color: #e8552d;
}

.dish-select {
  min-width: 104rpx;
  height: 54rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #e8552d;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 8rpx 16rpx rgba(232, 85, 45, 0.18);
}

.dish-select-arrow {
  font-size: 25rpx;
  line-height: 1;
}

.dish-select-disabled {
  background: #eceef0;
  color: #9ca3af;
  box-shadow: none;
}

.dish-select-quiet {
  min-width: auto;
  padding: 0 12rpx;
  background: #fff3ed;
  color: #b45309;
  box-shadow: none;
}

/* ========== 购物车底部弹层 ========== */
.cart-preview-sheet {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
  padding-top: 16rpx;
}

.cart-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1ece5;
}

.cart-preview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.cart-preview-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.cart-preview-clear {
  flex-shrink: 0;
  padding: 8rpx 4rpx;
  font-size: 22rpx;
  color: #9a6b4f;
}

.cart-preview-list {
  height: 39vh;
  margin-top: 4rpx;
}

.cart-preview-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f0ea;
}

.cart-preview-thumb {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
}

.cart-preview-main {
  min-width: 0;
}

.cart-preview-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.cart-preview-flavor {
  margin-top: 3rpx;
  font-size: 18rpx;
  color: #9a6b4f;
}

.cart-preview-unit {
  margin-top: 3rpx;
  font-size: 19rpx;
  color: #9ca3af;
}

.cart-preview-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}

.cart-preview-line {
  font-size: 25rpx;
  font-weight: 700;
  color: #e8552d;
}

.sheet-stepper {
  display: flex;
  align-items: center;
  gap: 3rpx;
}

.sheet-step {
  width: 50rpx !important;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6e0d8;
  border-radius: 50%;
  background: #ffffff;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1;
}

.sheet-step-plus {
  border-color: #f3b39d;
  background: #fdf0e8;
  color: #c14f27;
}

.sheet-step-busy {
  opacity: 0.5;
}

.sheet-step-value {
  min-width: 42rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.cart-preview-foot {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1ece5;
}

.cart-preview-total {
  flex: 1;
}

.cart-preview-money {
  margin-top: 1rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #1f2937;
}

.cart-preview-btn {
  width: 260rpx !important;
  height: 78rpx;
  flex-shrink: 0;
}

