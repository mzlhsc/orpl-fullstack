<view class="page session-page">
  <block wx:if="{{session}}">
    <view class="hero session-hero">
      <view class="hero-inner">
        <view class="brand-line">
          <view class="brand"><view class="brand-dot"></view>TABLE SESSION</view>
          <view class="tag tag-{{session.statusTone}}">{{session.statusText}}</view>
        </view>
        <view class="session-table-name">{{session.tableName}}</view>
        <view class="session-no">{{session.sessionNo}} <text class="session-copy" bindtap="onCopySessionNo">复制</text></view>
        <view class="session-hero-row">
          <view>
            <view class="session-hero-label">本桌消费</view>
            <view class="session-hero-total"><text class="session-yen">¥</text>{{session.totalText}}</view>
          </view>
          <view class="session-hero-side">
            <view class="session-hero-label">已支付 ¥{{session.paidText}}</view>
            <view class="session-hero-label">开台 {{session.openTimeText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="page-pad session-body">
      <view wx:if="{{session.status === 2}}" class="notice notice-warm">
        {{session.aaEnabled === 1 ? '本桌已开启 AA 结账，请未支付的成员完成支付。' : '本桌已申请结账，等待服务员处理。'}}
      </view>
      <view wx:if="{{session.status === 3}}" class="notice notice-done">本桌已结账，谢谢光临。</view>
      <view wx:if="{{session.status === 4}}" class="notice notice-muted">本桌会话已取消。</view>

      <view wx:if="{{session.aaEnabled === 1}}" class="card aa-card">
        <view class="aa-card-top">
          <view>
            <view class="aa-title">AA 结账已开启</view>
            <view class="aa-sub">按未支付人数平摊剩余金额</view>
          </view>
          <view class="tag tag-warm">AA</view>
        </view>
        <view class="aa-metrics">
          <view class="aa-metric">
            <view class="aa-value">¥{{session.perPersonText}}</view>
            <view class="aa-label">当前人均</view>
          </view>
          <view class="aa-metric">
            <view class="aa-value">¥{{session.unpaidText}}</view>
            <view class="aa-label">待支付</view>
          </view>
          <view class="aa-metric">
            <view class="aa-value">¥{{session.paidText}}</view>
            <view class="aa-label">已支付</view>
          </view>
        </view>
      </view>

      <view class="section-head session-section-head">
        <view class="section-title">同桌成员</view>
        <view class="tiny muted">{{session.memberCount || 0}} 人</view>
      </view>
      <view class="card members-card">
        <view wx:for="{{members}}" wx:key="id" class="member-row">
          <view class="member-avatar">{{item.initial}}</view>
          <view class="grow">
            <view class="member-name">
              {{item.nameText}}
              <text wx:if="{{item.isMe}}" class="member-tag">我</text>
              <text wx:if="{{item.isOwnerFlag}}" class="member-tag member-tag-owner">发起人</text>
            </view>
            <view class="member-meta">{{item.payText}}<text wx:if="{{item.paidText !== '0.00'}}"> · ¥{{item.paidText}}</text></view>
          </view>
          <view class="member-pay {{item.payStatus === 1 ? 'member-pay-done' : ''}}">
            {{item.payStatus === 1 ? '✓' : '待付'}}
          </view>
        </view>
        <view wx:if="{{members.length === 0}}" class="loading-line">还没有成员</view>
      </view>

      <view class="section-head session-section-head">
        <view>
          <view class="section-title">本桌购物车</view>
          <view class="section-sub">共 {{cartCount}} 件 · 合计 ¥{{session.cartAmountText}}</view>
        </view>
        <view wx:if="{{canEditCart}}" class="cart-head-actions">
          <view class="session-link" bindtap="onAddDish">加菜</view>
          <view wx:if="{{carts.length > 0}}" class="session-link session-link-muted" bindtap="onClearCart">清空</view>
        </view>
      </view>
      <view class="card session-cart-card">
        <view wx:for="{{carts}}" wx:key="id" class="session-cart-item" data-id="{{item.id}}" bindlongpress="onRemoveCart">
          <view class="thumb thumb-sm session-cart-thumb">
            <image
              class="thumb-img"
              src="{{item.imageSrc}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onCartImageError"
            />
          </view>
          <view class="grow">
            <view class="session-cart-name">{{item.name}}</view>
            <view wx:if="{{item.flavorText}}" class="session-cart-flavor">{{item.flavorText}}</view>
            <view class="session-cart-unit">¥{{item.unitText}} / 份</view>
          </view>
          <view class="session-cart-right">
            <view class="session-cart-line">¥{{item.lineText}}</view>
            <view wx:if="{{canEditCart}}" class="mini-stepper">
              <button class="mini-step {{busyId === item.id ? 'mini-step-busy' : ''}}" data-id="{{item.id}}" bindtap="onMinusCart">−</button>
              <view class="mini-step-value">{{item.number}}</view>
              <button class="mini-step mini-step-plus {{busyId === item.id ? 'mini-step-busy' : ''}}" data-id="{{item.id}}" bindtap="onPlusCart">+</button>
            </view>
            <view wx:else class="session-cart-number">×{{item.number}}</view>
          </view>
        </view>
        <view wx:if="{{carts.length === 0}}" class="session-cart-empty">
          <view>还没有加菜</view>
          <view wx:if="{{canEditCart}}" class="session-link" bindtap="onAddDish">去点菜 ›</view>
        </view>
        <view wx:if="{{canSubmit}}" class="session-cart-submit">
          <button class="btn btn-primary btn-block" bindtap="onSubmitOrder">
            {{submitButtonText}} · ¥{{session.cartAmountText}}
          </button>
        </view>
      </view>

      <view class="section-head session-section-head">
        <view>
          <view class="section-title">本单菜品</view>
          <view class="section-sub">
            {{hasSubmittedOrder ? orderRounds.length + ' 次下单' : '还没有提交过菜品'}}
            <text wx:if="{{hasSubmittedOrder}}"> · #{{currentOrderNo}}</text>
          </view>
        </view>
        <view wx:if="{{canEditCart}}" class="session-link" bindtap="onAddDish">加菜</view>
      </view>
      <view class="card session-order-rounds-card">
        <view wx:if="{{orderRounds.length === 0}}" class="session-order-empty">
          <view class="session-order-empty-title">当前还没有堂食订单</view>
          <view class="session-order-empty-text">把本桌购物车里的菜确认下单后，会生成当前订单；之后加餐都并入同一单。</view>
        </view>

        <view wx:for="{{orderRounds}}" wx:key="round" class="session-round-block">
          <view class="session-round-head">
            <view>
              <view class="session-round-label">{{item.label}}</view>
              <view class="session-round-time">{{item.timeText}}</view>
              <view
                wx:if="{{item.orderNumber && item.orderNumber !== currentOrderNo}}"
                class="session-round-original"
              >原订单 {{item.orderNumber}}</view>
            </view>
            <view class="session-round-amount">¥{{item.amountText}}</view>
          </view>
          <view
            wx:for="{{item.items}}"
            wx:for-item="dish"
            wx:key="id"
            class="session-round-item"
          >
            <view class="thumb-sm session-round-thumb">
              <image class="thumb-img" src="{{dish.imageSrc}}" mode="aspectFill" />
            </view>
            <view class="grow">
              <view class="session-round-name">{{dish.name}}</view>
              <view wx:if="{{dish.flavorText}}" class="session-round-flavor">{{dish.flavorText}}</view>
            </view>
            <view class="session-round-right">
              <view class="session-round-qty">×{{dish.number}}</view>
              <view class="session-round-line">¥{{dish.lineText}}</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{session.remark}}" class="session-remark">备注：{{session.remark}}</view>
      <view class="session-note">同桌成员共享购物车；首次下单生成当前订单，后续加餐都并入同一订单号。</view>
    </view>

    <view wx:if="{{session.status === 1}}" class="fixed-bottom session-actions-bar">
      <view class="session-actions">
        <button class="btn btn-ghost session-action-btn" bindtap="onRequestCheckout">申请结账</button>
        <button class="btn btn-soft session-action-btn" bindtap="onEnableAa">开启 AA</button>
      </view>
    </view>
    <view wx:elif="{{session.status === 2 && session.aaEnabled === 1}}" class="fixed-bottom session-actions-bar">
      <view wx:if="{{canAaPay}}" class="aa-pay-bar">
        <view class="aa-pay-info">
          <view class="tiny muted">我的 AA 份额</view>
          <view class="aa-pay-money">¥{{aaShareText}}</view>
        </view>
        <button class="btn btn-primary aa-pay-btn" bindtap="onAaPay">支付我的份额</button>
      </view>
      <view wx:else class="session-settled">你已完成支付，等待同桌完成 AA。</view>
    </view>
    <view wx:elif="{{session.status === 2}}" class="fixed-bottom session-actions-bar">
      <view class="session-settled">已申请结账，等待服务员处理。</view>
    </view>
    <view wx:else class="fixed-bottom session-actions-bar">
      <button class="btn btn-primary btn-block" bindtap="goDining">回到堂食</button>
    </view>
  </block>

  <block wx:elif="{{loading}}">
    <view class="loading-page">
      <view class="empty-art"></view>
      <view class="loading-line">正在读取本桌会话…</view>
    </view>
  </block>

  <block wx:else>
    <view class="empty detail-error">
      <view class="empty-art"></view>
      <view class="empty-title">堂食会话没加载出来</view>
      <view class="empty-text">{{error}}</view>
      <button class="btn btn-primary btn-sm retry-btn" bindtap="onRetry">重新加载</button>
    </view>
  </block>
</view>
