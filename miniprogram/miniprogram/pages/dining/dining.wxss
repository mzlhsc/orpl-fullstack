.dining-hero {
  padding-bottom: 34rpx;
}

.dining-hero .hero-title {
  margin-top: 20rpx;
  font-size: 46rpx;
}

.scan-panel {
  margin-top: 28rpx;
}

.scan-main {
  width: 100% !important;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #e8552d;
  color: #ffffff;
  text-align: left;
  box-shadow: 0 14rpx 28rpx rgba(232, 85, 45, 0.22);
}

.scan-main:active {
  background: #d44a24;
}

.scan-glyph {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.scan-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-color: #ffffff;
  border-style: solid;
}

.scan-corner-tl {
  left: 0;
  top: 0;
  border-width: 3rpx 0 0 3rpx;
}

.scan-corner-tr {
  right: 0;
  top: 0;
  border-width: 3rpx 3rpx 0 0;
}

.scan-corner-bl {
  left: 0;
  bottom: 0;
  border-width: 0 0 3rpx 3rpx;
}

.scan-corner-br {
  right: 0;
  bottom: 0;
  border-width: 0 3rpx 3rpx 0;
}

.scan-main-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.scan-main-sub {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.72);
}

.dining-body {
  padding-top: 20rpx;
}

.active-card {
  margin-top: 0;
  padding: 22rpx;
  border-color: #f1ddce;
}

.active-card:active {
  opacity: 0.9;
}

.active-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.active-table {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.active-table-icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #1f2937;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}

.active-table-name {
  font-size: 30rpx;
  font-weight: 700;
}

.active-table-no {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #9ca3af;
}

.active-metrics {
  display: flex;
  align-items: stretch;
  margin-top: 20rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3efe9;
  border-bottom: 1rpx solid #f3efe9;
}

.active-metric {
  flex: 1;
  text-align: center;
}

.active-metric + .active-metric {
  border-left: 1rpx solid #f3efe9;
}

.active-metric-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.active-metric-label {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #9ca3af;
}

.active-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.active-btn {
  flex: 1;
  height: 64rpx;
}

.not-seated {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
}

.not-seated-art {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #fbf7f1 url('/assets/food/placeholder.jpg') center / cover no-repeat;
  opacity: 0.75;
}

.not-seated-title {
  font-size: 26rpx;
  font-weight: 700;
}

.not-seated-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.not-seated-btn {
  flex-shrink: 0;
  height: 58rpx;
}

.dining-section-head {
  margin-top: 30rpx;
}

.reserve-head {
  margin-top: 30rpx;
}

.reserve-empty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}

.reserve-empty-title {
  font-size: 24rpx;
  font-weight: 600;
}

.reserve-empty-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.reserve-empty-arrow {
  font-size: 36rpx;
  color: #c3c7cd;
}

.reservation-card {
  position: relative;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.reservation-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.reservation-table {
  font-size: 27rpx;
  font-weight: 700;
}

.reservation-time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #4b5563;
}

.reservation-meta {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #9ca3af;
}

.reservation-cancel {
  margin-top: 12rpx;
  width: 168rpx;
}

.dining-note {
  padding: 26rpx 10rpx 30rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.open-sheet {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.open-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}

.open-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5563;
}

.open-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.open-step {
  width: 58rpx !important;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6e0d8;
  border-radius: 50%;
  background: #ffffff;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1;
}

.open-step-plus {
  border-color: #f3b39d;
  background: #fdf0e8;
  color: #c14f27;
}

.open-count {
  min-width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.open-submit {
  margin-top: 6rpx;
}

.retry-btn {
  margin-top: 24rpx;
}
