.address-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.address-head {
  padding: 30rpx 28rpx 14rpx;
}

.address-sub {
  margin-top: 8rpx;
}

.address-body {
  padding-top: 16rpx;
}

.notice {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #f6d9bd;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9a5b19;
  font-size: 22rpx;
}

.address-item {
  padding: 22rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border: 1rpx solid #efe8df;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.05);
}

.address-item:active {
  opacity: 0.88;
}

.address-item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 700;
}

.address-phone {
  margin-left: 10rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: #6b7280;
}

.address-labels {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.address-full {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6b7280;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3efe9;
}

.address-action {
  font-size: 20rpx;
  color: #b45309;
}

.address-action-danger {
  color: #b23a2f;
}

.address-select-hint {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 600;
  color: #1f2937;
}

.address-empty {
  padding-top: 120rpx;
}

.empty-action {
  margin-top: 26rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.add-address-bar {
  padding-top: 14rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}
