<view class="page edit-address-page">
  <view class="page-head edit-address-head">
    <view class="eyebrow">ADDRESS BOOK</view>
    <view class="title">{{editing ? '编辑收货地址' : '新增收货地址'}}</view>
    <view class="muted small edit-address-sub">填写准确的信息，让外卖顺利找到你。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-line">正在读取地址…</view>

  <block wx:else>
    <view class="page-pad edit-address-body">
      <view class="card card-pad">
        <view class="field">
          <view class="field-label">收货人</view>
          <input
            class="field-input"
            value="{{consignee}}"
            maxlength="20"
            placeholder="请输入收货人姓名"
            placeholder-class="placeholder"
            bindinput="onConsigneeInput"
          />
        </view>
        <view class="field">
          <view class="field-label">手机号</view>
          <input
            class="field-input"
            value="{{phone}}"
            maxlength="11"
            type="number"
            placeholder="用于配送联系"
            placeholder-class="placeholder"
            bindinput="onPhoneInput"
          />
          <view wx:if="{{phoneError}}" class="field-error">{{phoneError}}</view>
        </view>
        <view class="field">
          <view class="field-label">省市区</view>
          <picker mode="region" value="{{region}}" bindchange="onRegionChange">
            <view class="region-picker {{regionText ? '' : 'region-empty'}}">
              <text>{{regionText || '请选择省 / 市 / 区'}}</text>
              <view class="chev"></view>
            </view>
          </picker>
        </view>
        <view class="field edit-last-field">
          <view class="field-label">详细地址</view>
          <textarea
            class="field-textarea detail-textarea"
            value="{{detail}}"
            maxlength="80"
            placeholder="街道、门牌号、楼层和房间号"
            placeholder-class="placeholder"
            bindinput="onDetailInput"
          ></textarea>
        </view>
      </view>

      <view class="section-head edit-section-head">
        <view class="section-title">地址标签</view>
        <view class="tiny muted">方便下次快速选择</view>
      </view>
      <view class="card card-pad">
        <view class="label-options">
          <view
            wx:for="{{labels}}"
            wx:key="*this"
            class="chip {{label === item ? 'chip-active' : ''}}"
            data-label="{{item}}"
            bindtap="onLabelTap"
          >{{item}}</view>
        </view>
      </view>

      <view class="edit-note">
        新增地址默认不是默认地址，可在地址列表中单独设置。
      </view>
    </view>

    <view class="fixed-bottom edit-fixed">
      <button
        class="btn btn-primary btn-block {{saving ? 'btn-disabled' : ''}}"
        bindtap="onSave"
      >{{saving ? '保存中…' : '保存地址'}}</button>
    </view>
  </block>
</view>
