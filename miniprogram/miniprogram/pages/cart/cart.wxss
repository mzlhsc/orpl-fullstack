.cart-hero {
  padding-bottom: 34rpx;
}

.cart-hero .hero-title {
  margin-top: 18rpx;
  font-size: 46rpx;
}

.cart-clear {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.cart-body {
  padding-top: 22rpx;
  padding-bottom: 180rpx;
}

.dining-session-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #f2d2c2;
  border-radius: 20rpx;
  background: #fff8f3;
}

.dining-session-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 15rpx;
  background: #e8552d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.dining-session-title {
  font-size: 25rpx;
  font-weight: 700;
}

.dining-session-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9a6b4f;
}

.notice {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.notice-warm {
  border: 1rpx solid #f6d9bd;
  background: #fff7ed;
  color: #9a5b19;
}

.cart-empty {
  padding-top: 110rpx;
}

.empty-action {
  margin-top: 26rpx;
}

.cart-list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cart-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.cart-thumb {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.cart-item-main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 150rpx;
  padding: 2rpx 0;
}

.cart-item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.cart-item-name {
  font-size: 28rpx;
  font-weight: 700;
}

.cart-item-line {
  font-size: 26rpx;
  font-weight: 700;
  color: #e8552d;
  white-space: nowrap;
}

.cart-item-flavor {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f8f4ee;
  font-size: 19rpx;
  color: #9a6b4f;
}

.cart-item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.cart-unit {
  font-size: 20rpx;
  color: #9ca3af;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.step-btn {
  width: 54rpx !important;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6e0d8;
  border-radius: 50%;
  background: #ffffff;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1;
}

.step-plus {
  border-color: #f3b39d;
  background: #fdf0e8;
  color: #c14f27;
}

.step-btn-busy {
  opacity: 0.5;
}

.step-value {
  min-width: 42rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
}

.summary-card {
  margin-top: 10rpx;
  padding: 22rpx 26rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.summary-label {
  font-size: 24rpx;
  color: #6b7280;
}

.summary-value {
  font-size: 25rpx;
  font-weight: 500;
}

.summary-divider {
  margin: 10rpx 0;
}

.summary-total .summary-label {
  font-weight: 700;
  color: #1f2937;
}

.summary-amount {
  font-size: 38rpx;
  font-weight: 700;
  color: #e8552d;
}

.cart-note {
  padding: 18rpx 8rpx 26rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #9ca3af;
  text-align: center;
}

.cart-fixed-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cart-fixed-total {
  flex: 1;
}

.cart-fixed-money {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #1f2937;
}

.checkout-btn {
  width: 290rpx !important;
  height: 82rpx;
  flex-shrink: 0;
}

/* ========== 堂食当前订单 + 本次加菜 ========== */
.cart-dining-page .cart-body {
  padding-bottom: 190rpx;
}

.current-order-section {
  margin-bottom: 26rpx;
}

.current-order-head {
  align-items: center;
  margin-bottom: 14rpx;
}

.current-order-no {
  max-width: 260rpx;
  padding: 8rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid #efd9cb;
  border-radius: 999rpx;
  background: #fff7f1;
  color: #b45309;
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-order-card {
  padding: 6rpx 20rpx;
}

.current-order-empty {
  padding: 28rpx 0 30rpx;
}

.current-order-empty-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #4b5563;
}

.current-order-empty-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: #9ca3af;
}

.order-round-block {
  padding: 18rpx 0 12rpx;
  border-bottom: 1rpx solid #f1ece5;
}

.order-round-block:last-child {
  border-bottom: none;
}

.order-round-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  padding-bottom: 10rpx;
}

.order-round-label {
  padding-left: 14rpx;
  position: relative;
  font-size: 25rpx;
  font-weight: 700;
  color: #1f2937;
}

.order-round-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 24rpx;
  transform: translateY(-50%);
  border-radius: 6rpx;
  background: #e8552d;
}

.order-round-time {
  margin-top: 4rpx;
  padding-left: 14rpx;
  font-size: 18rpx;
  color: #9ca3af;
}

.order-round-original {
  margin-top: 2rpx;
  padding-left: 14rpx;
  font-size: 18rpx;
  color: #8a8f98;
}

.order-round-amount {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: #e8552d;
}

.order-round-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0 12rpx 14rpx;
}

.order-round-thumb {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  border-radius: 13rpx;
}

.order-round-name {
  font-size: 23rpx;
  font-weight: 600;
  color: #374151;
}

.order-round-flavor {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #9a6b4f;
}

.order-round-right {
  flex-shrink: 0;
  text-align: right;
}

.order-round-qty {
  font-size: 20rpx;
  color: #6b7280;
}

.order-round-line {
  margin-top: 3rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4b5563;
}

.cart-empty-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  margin-top: 4rpx;
}

.cart-empty-inline-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #374151;
}

.cart-empty-inline-text {
  margin-top: 5rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

