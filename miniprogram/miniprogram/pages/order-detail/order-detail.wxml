<view class="page detail-page">
  <block wx:if="{{order}}">
    <view class="hero detail-hero">
      <view class="hero-inner">
        <view class="brand-line">
          <view class="brand"><view class="brand-dot"></view>ORDER DETAIL</view>
          <view class="tag tag-{{order.statusTone}}">{{order.statusText}}</view>
        </view>
        <view class="detail-status">{{order.statusText}}</view>
        <view class="detail-amount"><text class="detail-yen">¥</text>{{order.amountText}}</view>
        <view class="detail-hint">{{order.statusHint}}</view>
      </view>
    </view>

    <view class="page-pad detail-body">
      <view wx:if="{{isNew}}" class="new-banner">
        <view class="new-banner-icon">✓</view>
        <view>
          <view class="new-banner-title">下单成功</view>
          <view class="new-banner-text">{{order.status >= 3 ? '门店已接单，正在为你备餐。' : '门店正在确认，接单后会尽快为你准备。'}}</view>
        </view>
      </view>

      <view wx:if="{{steps.length > 0}}" class="card steps-card">
        <view class="steps">
          <block wx:for="{{steps}}" wx:key="label">
            <view class="step-item">
              <view class="step-dot step-{{item.state}}">
                <text wx:if="{{item.state === 'done'}}">✓</text>
              </view>
              <view class="step-label step-label-{{item.state}}">{{item.label}}</view>
            </view>
            <view wx:if="{{index < steps.length - 1}}" class="step-line {{item.state === 'done' ? 'step-line-done' : ''}}"></view>
          </block>
        </view>
      </view>

      <view wx:if="{{order.status === 6 || order.status === 7}}" class="notice notice-cancel">
        <view class="notice-title">{{order.status === 6 ? '订单已取消' : '退款处理中'}}</view>
        <view class="notice-text">{{order.cancelReason || '如有疑问，请联系门店。'}}</view>
      </view>

      <view class="section-head detail-section-head">
        <view class="section-title">菜品明细</view>
        <view class="tiny muted">共 {{count}} 件</view>
      </view>
      <view class="card detail-items-card">
        <view wx:for="{{details}}" wx:key="id" class="detail-item">
          <view class="thumb thumb-sm detail-thumb">
            <image
              class="thumb-img"
              src="{{item.imageSrc}}"
              mode="aspectFill"
              data-index="{{index}}"
              binderror="onItemImageError"
            />
          </view>
          <view class="grow">
            <view class="detail-item-name">{{item.name}}</view>
            <view wx:if="{{item.flavorText}}" class="detail-item-flavor">{{item.flavorText}}</view>
            <view class="detail-item-unit">¥{{item.unitText}} × {{item.number}}</view>
          </view>
          <view class="detail-item-price">¥{{item.lineText}}</view>
        </view>
        <view wx:if="{{details.length === 0}}" class="loading-line">暂无菜品明细</view>
      </view>

      <view class="section-head detail-section-head">
        <view class="section-title">{{order.isDining ? '堂食信息' : '配送信息'}}</view>
        <view class="copy-link" bindtap="onCopyAddress">复制</view>
      </view>
      <view class="card card-pad detail-info-card">
        <block wx:if="{{order.isDining}}">
          <view class="detail-row">
            <view class="detail-label">订单类型</view>
            <view class="detail-value">堂食</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">桌台备注</view>
            <view class="detail-value">{{order.remark || '堂食订单'}}</view>
          </view>
        </block>
        <block wx:else>
          <view class="detail-row">
            <view class="detail-label">收货人</view>
            <view class="detail-value">{{order.consignee}} · {{order.phone}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">地址</view>
            <view class="detail-value detail-address">{{order.address || '—'}}</view>
          </view>
        </block>
        <view class="divider detail-divider"></view>
        <view class="detail-row">
          <view class="detail-label">预计送达</view>
          <view class="detail-value">{{order.estimatedText || '下单后约 30 分钟'}}</view>
        </view>
        <view wx:if="{{order.deliveryText}}" class="detail-row">
          <view class="detail-label">实际送达</view>
          <view class="detail-value">{{order.deliveryText}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">餐具</view>
          <view class="detail-value">{{order.tablewareText}}</view>
        </view>
        <view wx:if="{{order.remark}}" class="detail-row">
          <view class="detail-label">备注</view>
          <view class="detail-value">{{order.remark}}</view>
        </view>
      </view>

      <view class="section-head detail-section-head">
        <view class="section-title">金额</view>
      </view>
      <view class="card card-pad amount-card">
        <view class="amount-row">
          <view class="amount-label">商品金额</view>
          <view class="amount-value">¥{{order.goodsAmountText}}</view>
        </view>
        <view class="amount-row">
          <view class="amount-label">打包费</view>
          <view class="amount-value">¥{{order.packText}}</view>
        </view>
        <view class="divider detail-divider"></view>
        <view class="amount-row amount-total">
          <view class="amount-label">实付金额</view>
          <view class="amount-total-value"><text class="price-symbol">¥</text>{{order.amountText}}</view>
        </view>
      </view>

      <view class="section-head detail-section-head">
        <view class="section-title">订单信息</view>
      </view>
      <view class="card card-pad detail-info-card">
        <view class="detail-row">
          <view class="detail-label">订单号</view>
          <view class="detail-value order-number-value">{{order.number}} <text class="copy-link" bindtap="onCopyNumber">复制</text></view>
        </view>
        <view class="detail-row">
          <view class="detail-label">下单时间</view>
          <view class="detail-value">{{order.timeText}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">支付方式</view>
          <view class="detail-value">{{order.payMethodText}} · {{order.payStatusText}}</view>
        </view>
        <view wx:if="{{order.checkoutText}}" class="detail-row">
          <view class="detail-label">完成时间</view>
          <view class="detail-value">{{order.checkoutText}}</view>
        </view>
      </view>

      <view class="detail-note">如需修改订单，请直接联系门店服务员。</view>
    </view>

    <view wx:if="{{order.canCancel || order.canRemind || order.canRepeat}}" class="fixed-bottom detail-actions-bar">
      <view class="detail-actions">
        <button wx:if="{{order.canCancel}}" class="btn btn-ghost detail-action-btn" bindtap="onCancel">取消订单</button>
        <button wx:if="{{order.canRemind}}" class="btn btn-soft detail-action-btn" bindtap="onRemind">催一催</button>
        <button wx:if="{{order.canRepeat}}" class="btn btn-primary detail-action-btn" bindtap="onRepeat">再来一单</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{loading}}">
    <view class="loading-page">
      <view class="empty-art"></view>
      <view class="loading-line">正在读取订单…</view>
    </view>
  </block>

  <block wx:else>
    <view class="empty detail-error">
      <view class="empty-art"></view>
      <view class="empty-title">订单详情没加载出来</view>
      <view class="empty-text">{{error}}</view>
      <button class="btn btn-primary btn-sm retry-btn" bindtap="onRetry">重新加载</button>
    </view>
  </block>
</view>
