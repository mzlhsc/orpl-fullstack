.reserve-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.reserve-hero {
  padding-bottom: 34rpx;
}

.reserve-hero .hero-title {
  margin-top: 20rpx;
  font-size: 46rpx;
}

.reserve-body {
  padding-top: 20rpx;
}

.reserve-form-card {
  padding: 2rpx 22rpx;
}

.picker-wrap {
  display: block;
}

.time-grid {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0;
}

.time-grid picker {
  flex: 1;
}

.time-box {
  padding: 16rpx 18rpx;
  border: 1rpx solid #eee6dc;
  border-radius: 16rpx;
  background: #fcfbf9;
}

.time-label {
  font-size: 19rpx;
  color: #9ca3af;
}

.time-value {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.reserve-stepper {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.reserve-step {
  width: 54rpx !important;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6e0d8;
  border-radius: 50%;
  background: #ffffff;
  color: #4b5563;
  font-size: 27rpx;
  line-height: 1;
}

.reserve-step-plus {
  border-color: #f3b39d;
  background: #fdf0e8;
  color: #c14f27;
}

.reserve-count {
  min-width: 42rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 700;
}

.reserve-section-head {
  margin-top: 28rpx;
}

.reserve-last-field {
  margin-bottom: 4rpx;
}

.field-error {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #c2412d;
}

.reserve-remark {
  min-height: 130rpx;
  border: none;
  background: transparent;
  padding: 8rpx 2rpx;
}

.reserve-note {
  padding: 20rpx 10rpx 30rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.reserve-empty {
  padding-top: 120rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.reserve-fixed {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.reserve-fixed-table {
  margin-top: 2rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.reserve-submit {
  width: 270rpx;
  height: 80rpx;
  flex-shrink: 0;
}
