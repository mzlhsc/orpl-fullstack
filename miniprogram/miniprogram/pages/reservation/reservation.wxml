<view class="page reserve-page">
  <view class="hero reserve-hero">
    <view class="hero-inner">
      <view class="brand-line">
        <view class="brand"><view class="brand-dot"></view>RESERVE A TABLE</view>
        <view class="pill pill-open">提前留桌</view>
      </view>
      <view class="hero-title">预约桌台</view>
      <view class="hero-subtitle">选好桌台和到店时间，我们会为你留一张桌。</view>
    </view>
  </view>

  <view class="page-pad reserve-body">
    <view wx:if="{{loading}}" class="loading-line">正在读取可预约桌台…</view>

    <block wx:elif="{{tables.length === 0}}">
      <view class="empty reserve-empty">
        <view class="empty-art"></view>
        <view class="empty-title">暂无可预约桌台</view>
        <view class="empty-text">可能已满桌或门店未开放预约，请稍后再试。</view>
        <button class="btn btn-primary btn-sm retry-btn" bindtap="retry">重新加载</button>
      </view>
    </block>

    <block wx:else>
      <view class="card reserve-form-card">
        <picker
          class="picker-wrap"
          mode="selector"
          range="{{tables}}"
          range-key="name"
          value="{{tableIndex}}"
          bindchange="onTableChange"
        >
          <view class="cell">
            <view class="cell-label">预约桌台</view>
            <view class="cell-value">
              {{selectedTable.name}} · {{selectedTable.seatsText}}
              <view class="chev"></view>
            </view>
          </view>
        </picker>
        <view class="divider"></view>
        <view class="time-grid">
          <picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
            <view class="time-box">
              <view class="time-label">到店日期</view>
              <view class="time-value">{{date}}</view>
            </view>
          </picker>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange">
            <view class="time-box">
              <view class="time-label">到店时间</view>
              <view class="time-value">{{time}}</view>
            </view>
          </picker>
        </view>
        <view class="divider"></view>
        <view class="cell">
          <view class="cell-label">就餐人数</view>
          <view class="reserve-stepper">
            <button class="reserve-step" bindtap="onGuestMinus">−</button>
            <view class="reserve-count">{{guestCount}}</view>
            <button class="reserve-step reserve-step-plus" bindtap="onGuestPlus">+</button>
          </view>
        </view>
      </view>

      <view class="section-head reserve-section-head">
        <view class="section-title">联系人</view>
        <view class="tiny muted">方便门店确认预约</view>
      </view>
      <view class="card card-pad">
        <view class="field">
          <view class="field-label">联系人</view>
          <input
            class="field-input"
            value="{{contactName}}"
            maxlength="20"
            placeholder="怎么称呼你？"
            placeholder-class="placeholder"
            bindinput="onContactInput"
          />
        </view>
        <view class="field reserve-last-field">
          <view class="field-label">手机号</view>
          <input
            class="field-input"
            value="{{contactPhone}}"
            maxlength="11"
            type="number"
            placeholder="用于接收预约确认"
            placeholder-class="placeholder"
            bindinput="onPhoneInput"
          />
          <view wx:if="{{phoneError}}" class="field-error">{{phoneError}}</view>
        </view>
      </view>

      <view class="section-head reserve-section-head">
        <view class="section-title">备注</view>
        <view class="tiny muted">选填</view>
      </view>
      <view class="card card-pad">
        <textarea
          class="field-textarea reserve-remark"
          value="{{remark}}"
          maxlength="60"
          placeholder="例如：需要宝宝椅、靠窗座位…"
          placeholder-class="placeholder"
          bindinput="onRemarkInput"
        ></textarea>
      </view>

      <view class="reserve-note">
        预约提交后需等待门店确认；到店后可在堂食页扫码开台。
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && tables.length > 0}}" class="fixed-bottom">
    <view class="reserve-fixed">
      <view class="grow">
        <view class="tiny muted">{{date}} {{time}} · {{guestCount}} 人</view>
        <view class="reserve-fixed-table">{{selectedTable.name}}</view>
      </view>
      <button
        class="btn reserve-submit {{submitting ? 'btn-disabled' : 'btn-primary'}}"
        bindtap="onSubmit"
      >{{submitting ? '提交中…' : '提交预约'}}</button>
    </view>
  </view>
</view>
