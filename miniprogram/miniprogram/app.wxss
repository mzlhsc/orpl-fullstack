/**app.wxss**/
page {
  background: #f7f4ef;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
image,
scroll-view,
picker {
  box-sizing: border-box;
}

button {
  width: auto !important;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1;
  color: inherit;
}

button::after {
  border: none;
}

image {
  display: block;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-tab {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.page-pad {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 42rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1f2937 0%, #263241 58%, #3a2c26 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero::after {
  content: "";
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  top: -140rpx;
  border-radius: 50%;
  background: rgba(232, 85, 45, 0.22);
  pointer-events: none;
}

.hero::before {
  content: "";
  position: absolute;
  width: 170rpx;
  height: 170rpx;
  left: -70rpx;
  bottom: -90rpx;
  border-radius: 50%;
  background: rgba(232, 85, 45, 0.12);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.brand-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.78);
}

.brand-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  background: #e8552d;
}

.hero-title {
  margin-top: 26rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.pill-open {
  color: #fbd8ca;
  background: rgba(232, 85, 45, 0.22);
  border: 1rpx solid rgba(232, 85, 45, 0.4);
}

.pill-close {
  color: #d1d5db;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.card {
  background: #ffffff;
  border: 1rpx solid #efe8df;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 40rpx rgba(31, 41, 55, 0.055);
}

.card-pad {
  padding: 26rpx;
}

.card-flat {
  background: #ffffff;
  border: 1rpx solid #efe8df;
  border-radius: 24rpx;
}

.section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #1f2937;
}

.section-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8f98;
}

.eyebrow {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #b45309;
  text-transform: uppercase;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1f2937;
}

.muted {
  color: #8a8f98;
}

.small {
  font-size: 22rpx;
}

.tiny {
  font-size: 20rpx;
}

.bold {
  font-weight: 700;
}

.accent {
  color: #e8552d;
}

.money {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8552d;
}

.money-large {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  color: #e8552d;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 2rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.gap-xs {
  gap: 10rpx;
}

.gap-sm {
  gap: 18rpx;
}

.gap-md {
  gap: 26rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.divider {
  height: 1rpx;
  background: #f0ece6;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.tag-warm {
  color: #a8461f;
  background: #fdf0e8;
}

.tag-active {
  color: #16803c;
  background: #eaf5ee;
}

.tag-blue {
  color: #2f6f8f;
  background: #eaf2f6;
}

.tag-done {
  color: #16803c;
  background: #eaf5ee;
}

.tag-muted {
  color: #6b7280;
  background: #f1f2f4;
}

.tag-dark {
  color: #ffffff;
  background: #1f2937;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-primary {
  color: #ffffff;
  background: #e8552d;
  box-shadow: 0 12rpx 26rpx rgba(232, 85, 45, 0.24);
}

.btn-primary:active {
  background: #d44a24;
}

.btn-dark {
  color: #ffffff;
  background: #1f2937;
}

.btn-ghost {
  color: #1f2937;
  background: #ffffff;
  border: 1rpx solid #e4ddd4;
}

.btn-soft {
  color: #a8461f;
  background: #fdf0e8;
  border: 1rpx solid #f7d8c9;
}

.btn-sm {
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.btn-xs {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.btn-disabled {
  color: #9ca3af;
  background: #eceef0;
  box-shadow: none;
}

.btn-block {
  width: 100% !important;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5563;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e8e1d9;
  border-radius: 16rpx;
  background: #fcfbf9;
  font-size: 28rpx;
  color: #1f2937;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e8e1d9;
  border-radius: 16rpx;
  background: #fcfbf9;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1f2937;
}

.placeholder {
  color: #a8abb2;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e8e1d9;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 23rpx;
  color: #4b5563;
  white-space: nowrap;
}

.chip-active {
  border-color: #f3b39d;
  background: #fdf0e8;
  color: #b8461f;
  font-weight: 600;
}

.scroll-x {
  width: 100%;
  white-space: nowrap;
}

.scroll-x-inner {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 2rpx 2rpx 6rpx;
}

.tab-pills {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.05);
}

.tab-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
}

.tab-pill-active {
  color: #ffffff;
  background: #1f2937;
  box-shadow: 0 8rpx 18rpx rgba(31, 41, 55, 0.18);
}

.thumb {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  background: #f1ede6;
  overflow: hidden;
}

.thumb-sm {
  width: 116rpx;
  height: 116rpx;
  border-radius: 16rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.search-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: "";
  position: absolute;
  width: 12rpx;
  height: 3rpx;
  right: -9rpx;
  bottom: -4rpx;
  background: rgba(255, 255, 255, 0.62);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #ffffff;
  font-size: 25rpx;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.44);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-art {
  width: 190rpx;
  height: 190rpx;
  margin-bottom: 22rpx;
  border-radius: 30rpx;
  background: #fbf7f1 url('/assets/food/placeholder.jpg') center / cover no-repeat;
  opacity: 0.82;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4b5563;
}

.empty-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.fixed-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 16rpx;
  border: 1rpx solid #e8e1d9;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 50rpx rgba(31, 41, 55, 0.16);
}

.fixed-bar-tab {
  bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #efe8df;
  box-shadow: 0 -14rpx 36rpx rgba(31, 41, 55, 0.06);
}

.sheet-mask,
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(17, 24, 39, 0.52);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: 84vh;
  padding: 26rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 70rpx rgba(17, 24, 39, 0.22);
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8f98;
}

.sheet-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 30rpx;
}

.modal {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 101;
  width: 640rpx;
  max-height: 76vh;
  transform: translate(-50%, -50%);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(17, 24, 39, 0.24);
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 4rpx;
  gap: 20rpx;
}

.cell-label {
  font-size: 25rpx;
  color: #6b7280;
}

.cell-value {
  font-size: 25rpx;
  font-weight: 500;
  color: #1f2937;
  text-align: right;
}

.chev {
  width: 16rpx;
  height: 16rpx;
  margin-left: 10rpx;
  border-top: 2rpx solid #9ca3af;
  border-right: 2rpx solid #9ca3af;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.loading-line {
  padding: 40rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
}

.footer-note {
  padding: 36rpx 20rpx 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b0b4ba;
  letter-spacing: 1rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8552d, #f08d62);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 24rpx rgba(232, 85, 45, 0.28);
}

.list-card {
  margin-bottom: 20rpx;
}

.list-card:active {
  opacity: 0.85;
}
